{
  "swagger": "2.0",
  "info": {
    "version": "1.0",
    "title": "K2 for Microsoft Teams",
    "description": "Manage Microsoft Teams and Channels via Microsoft Graph API. OAuth handled by K2.",
    "contact": {}
  },
  "host": "graph.microsoft.com",
  "basePath": "/v1.0",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "paths": {

    "/groups": {
      "post": {
        "summary": "Create Group",
        "description": "Creates an Office 365 Group which is the first step in creating a Team.",
        "operationId": "CreateGroup",
        "tags": ["Teams"],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/CreateGroupRequest" }
          }
        ],
        "responses": {
          "201": {
            "description": "Group created successfully",
            "schema": { "$ref": "#/definitions/Group" }
          }
        }
      }
    },

    "/groups/{groupId}/team": {
      "put": {
        "summary": "Provision Team from Group",
        "description": "Creates a Team under an existing Office 365 Group.",
        "operationId": "ProvisionTeam",
        "tags": ["Teams"],
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The ID of the Office 365 Group to convert to a Team"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/ProvisionTeamRequest" }
          }
        ],
        "responses": {
          "201": {
            "description": "Team provisioned successfully",
            "schema": { "$ref": "#/definitions/Team" }
          }
        }
      }
    },

    "/teams/{teamId}": {
      "get": {
        "summary": "Get Team",
        "description": "Get the properties of a Team by its ID.",
        "operationId": "GetTeam",
        "tags": ["Teams"],
        "parameters": [
          {
            "name": "teamId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The ID of the Team"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": { "$ref": "#/definitions/Team" }
          }
        }
      },
      "delete": {
        "summary": "Delete Team",
        "description": "Deletes a Team and its associated Office 365 Group.",
        "operationId": "DeleteTeam",
        "tags": ["Teams"],
        "parameters": [
          {
            "name": "teamId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The ID of the Team to delete"
          }
        ],
        "responses": {
          "204": {
            "description": "Team deleted successfully"
          }
        }
      }
    },

    "/groups/{teamId}/members/$ref": {
      "post": {
        "summary": "Add Team Member",
        "description": "Add a user as a member of a Team.",
        "operationId": "AddTeamMember",
        "tags": ["Teams"],
        "parameters": [
          {
            "name": "teamId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The ID of the Team"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/DirectoryObjectRef" }
          }
        ],
        "responses": {
          "204": {
            "description": "Member added successfully"
          }
        }
      }
    },

    "/groups/{teamId}/members/{memberId}/$ref": {
      "delete": {
        "summary": "Remove Team Member",
        "description": "Remove a user from a Team.",
        "operationId": "RemoveTeamMember",
        "tags": ["Teams"],
        "parameters": [
          {
            "name": "teamId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The ID of the Team"
          },
          {
            "name": "memberId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The ID of the member to remove"
          }
        ],
        "responses": {
          "204": {
            "description": "Member removed successfully"
          }
        }
      }
    },

    "/groups/{teamId}/owners/$ref": {
      "post": {
        "summary": "Add Team Owner",
        "description": "Add a user as an owner of a Team.",
        "operationId": "AddTeamOwner",
        "tags": ["Teams"],
        "parameters": [
          {
            "name": "teamId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The ID of the Team"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/DirectoryObjectRef" }
          }
        ],
        "responses": {
          "204": {
            "description": "Owner added successfully"
          }
        }
      }
    },

    "/groups/{teamId}/owners/{ownerId}/$ref": {
      "delete": {
        "summary": "Remove Team Owner",
        "description": "Remove a user as an owner of a Team.",
        "operationId": "RemoveTeamOwner",
        "tags": ["Teams"],
        "parameters": [
          {
            "name": "teamId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The ID of the Team"
          },
          {
            "name": "ownerId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The ID of the owner to remove"
          }
        ],
        "responses": {
          "204": {
            "description": "Owner removed successfully"
          }
        }
      }
    },

    "/teams/{teamId}/channels": {
      "post": {
        "summary": "Create Channel",
        "description": "Create a new channel in a Team.",
        "operationId": "CreateChannel",
        "tags": ["Channels"],
        "parameters": [
          {
            "name": "teamId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The ID of the Team"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/CreateChannelRequest" }
          }
        ],
        "responses": {
          "201": {
            "description": "Channel created successfully",
            "schema": { "$ref": "#/definitions/Channel" }
          }
        }
      },
      "get": {
        "summary": "List Channels",
        "description": "List all channels in a Team.",
        "operationId": "ListChannels",
        "tags": ["Channels"],
        "parameters": [
          {
            "name": "teamId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The ID of the Team"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": { "$ref": "#/definitions/ChannelList" }
          }
        }
      }
    },

    "/teams/{teamId}/channels/{channelId}": {
      "get": {
        "summary": "Get Channel",
        "description": "Get the properties of a specific channel.",
        "operationId": "GetChannel",
        "tags": ["Channels"],
        "parameters": [
          {
            "name": "teamId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The ID of the Team"
          },
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The ID of the Channel"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": { "$ref": "#/definitions/Channel" }
          }
        }
      },
      "patch": {
        "summary": "Update Channel",
        "description": "Update the name or description of a channel.",
        "operationId": "UpdateChannel",
        "tags": ["Channels"],
        "parameters": [
          {
            "name": "teamId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The ID of the Team"
          },
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The ID of the Channel"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/UpdateChannelRequest" }
          }
        ],
        "responses": {
          "204": {
            "description": "Channel updated successfully"
          }
        }
      },
      "delete": {
        "summary": "Delete Channel",
        "description": "Delete a channel from a Team.",
        "operationId": "DeleteChannel",
        "tags": ["Channels"],
        "parameters": [
          {
            "name": "teamId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The ID of the Team"
          },
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The ID of the Channel to delete"
          }
        ],
        "responses": {
          "204": {
            "description": "Channel deleted successfully"
          }
        }
      }
    },

    "/teams/{teamId}/channels/{channelId}/messages": {
      "post": {
        "summary": "Post Channel Message",
        "description": "Send a message to a Teams channel.",
        "operationId": "PostChannelMessage",
        "tags": ["Messages"],
        "parameters": [
          {
            "name": "teamId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The ID of the Team"
          },
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The ID of the Channel"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/MessageRequest" }
          }
        ],
        "responses": {
          "201": {
            "description": "Message sent successfully",
            "schema": { "$ref": "#/definitions/Message" }
          }
        }
      },
      "get": {
        "summary": "List Channel Messages",
        "description": "List messages in a Teams channel.",
        "operationId": "ListChannelMessages",
        "tags": ["Messages"],
        "parameters": [
          {
            "name": "teamId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The ID of the Team"
          },
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The ID of the Channel"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": { "$ref": "#/definitions/MessageList" }
          }
        }
      }
    },

    "/teams/{teamId}/channels/{channelId}/messages/{messageId}": {
      "get": {
        "summary": "Get Channel Message",
        "description": "Get a specific message from a Teams channel.",
        "operationId": "GetChannelMessage",
        "tags": ["Messages"],
        "parameters": [
          {
            "name": "teamId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The ID of the Team"
          },
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The ID of the Channel"
          },
          {
            "name": "messageId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The ID of the Message"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": { "$ref": "#/definitions/Message" }
          }
        }
      },
      "patch": {
        "summary": "Update Channel Message",
        "description": "Update the content of an existing channel message.",
        "operationId": "UpdateChannelMessage",
        "tags": ["Messages"],
        "parameters": [
          {
            "name": "teamId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The ID of the Team"
          },
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The ID of the Channel"
          },
          {
            "name": "messageId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The ID of the Message to update"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/MessageRequest" }
          }
        ],
        "responses": {
          "204": {
            "description": "Message updated successfully"
          }
        }
      }
    }

  },

  "definitions": {

    "CreateGroupRequest": {
      "type": "object",
      "required": ["displayName", "mailNickname", "mailEnabled", "securityEnabled", "groupTypes"],
      "properties": {
        "displayName": { "type": "string", "description": "The display name for the Team" },
        "description": { "type": "string", "description": "A description for the Team" },
        "mailNickname": { "type": "string", "description": "Mail alias for the group, no spaces" },
        "mailEnabled": { "type": "boolean", "description": "Must be true for Teams" },
        "securityEnabled": { "type": "boolean", "description": "Must be false for Teams" },
        "groupTypes": { "type": "array", "items": { "type": "string" }, "description": "Must include Unified for Teams" },
        "visibility": { "type": "string", "description": "Public or Private" }
      }
    },

    "Group": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "mail": { "type": "string" },
        "mailNickname": { "type": "string" },
        "visibility": { "type": "string" },
        "createdDateTime": { "type": "string" }
      }
    },

    "ProvisionTeamRequest": {
      "type": "object",
      "properties": {
        "memberSettings": { "$ref": "#/definitions/MemberSettings" },
        "messagingSettings": { "$ref": "#/definitions/MessagingSettings" },
        "funSettings": { "$ref": "#/definitions/FunSettings" }
      }
    },

    "Team": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "internalId": { "type": "string" },
        "webUrl": { "type": "string" },
        "isArchived": { "type": "boolean" },
        "memberSettings": { "$ref": "#/definitions/MemberSettings" },
        "guestSettings": { "$ref": "#/definitions/GuestSettings" },
        "messagingSettings": { "$ref": "#/definitions/MessagingSettings" },
        "funSettings": { "$ref": "#/definitions/FunSettings" }
      }
    },

    "MemberSettings": {
      "type": "object",
      "properties": {
        "allowCreateUpdateChannels": { "type": "boolean" },
        "allowDeleteChannels": { "type": "boolean" },
        "allowAddRemoveApps": { "type": "boolean" },
        "allowCreateUpdateRemoveTabs": { "type": "boolean" },
        "allowCreateUpdateRemoveConnectors": { "type": "boolean" }
      }
    },

    "GuestSettings": {
      "type": "object",
      "properties": {
        "allowCreateUpdateChannels": { "type": "boolean" },
        "allowDeleteChannels": { "type": "boolean" }
      }
    },

    "MessagingSettings": {
      "type": "object",
      "properties": {
        "allowUserEditMessages": { "type": "boolean" },
        "allowUserDeleteMessages": { "type": "boolean" },
        "allowOwnerDeleteMessages": { "type": "boolean" },
        "allowTeamMentions": { "type": "boolean" },
        "allowChannelMentions": { "type": "boolean" }
      }
    },

    "FunSettings": {
      "type": "object",
      "properties": {
        "allowGiphy": { "type": "boolean" },
        "giphyContentRating": { "type": "string" },
        "allowStickersAndMemes": { "type": "boolean" },
        "allowCustomMemes": { "type": "boolean" }
      }
    },

    "DirectoryObjectRef": {
      "type": "object",
      "required": ["odataid"],
      "properties": {
        "odataid": {
          "type": "string",
          "description": "Full Graph URL for the user e.g. https://graph.microsoft.com/v1.0/users/{userId}"
        }
      }
    },

    "CreateChannelRequest": {
      "type": "object",
      "required": ["displayName"],
      "properties": {
        "displayName": { "type": "string", "description": "Channel name, max 50 characters" },
        "description": { "type": "string", "description": "Optional description for the channel" },
        "membershipType": { "type": "string", "description": "standard, private, or shared. Cannot be changed after creation." },
        "isFavoriteByDefault": { "type": "boolean", "description": "Show channel in all members channel list by default" }
      }
    },

    "UpdateChannelRequest": {
      "type": "object",
      "properties": {
        "displayName": { "type": "string", "description": "New name for the channel, max 50 characters" },
        "description": { "type": "string", "description": "New description for the channel" }
      }
    },

    "Channel": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "email": { "type": "string" },
        "webUrl": { "type": "string" },
        "membershipType": { "type": "string", "description": "standard, private, or shared" },
        "isArchived": { "type": "boolean" },
        "isFavoriteByDefault": { "type": "boolean" },
        "tenantId": { "type": "string" },
        "createdDateTime": { "type": "string" }
      }
    },

    "ChannelList": {
      "type": "object",
      "properties": {
        "value": { "type": "array", "items": { "$ref": "#/definitions/Channel" } }
      }
    },

    "MessageBody": {
      "type": "object",
      "required": ["contentType", "content"],
      "properties": {
        "contentType": { "type": "string", "description": "text or html" },
        "content": { "type": "string", "description": "The message content" }
      }
    },

    "MessageRequest": {
      "type": "object",
      "required": ["body"],
      "properties": {
        "body": { "$ref": "#/definitions/MessageBody" },
        "subject": { "type": "string", "description": "Optional subject line for the message" },
        "importance": { "type": "string", "description": "normal, high, or urgent" }
      }
    },

    "Message": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "messageType": { "type": "string" },
        "createdDateTime": { "type": "string" },
        "lastModifiedDateTime": { "type": "string" },
        "lastEditedDateTime": { "type": "string" },
        "subject": { "type": "string" },
        "importance": { "type": "string" },
        "locale": { "type": "string" },
        "webUrl": { "type": "string" },
        "body": { "$ref": "#/definitions/MessageBody" }
      }
    },

    "MessageList": {
      "type": "object",
      "properties": {
        "value": { "type": "array", "items": { "$ref": "#/definitions/Message" } }
      }
    }

  }
}
