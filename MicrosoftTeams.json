      }
    },
    "OdataIdRequest": {
      "type": "object",
      "required": ["odataid"],
      "properties": {
        "odataid": {
          "type": "string",
          "description": "The @odata.id URL for the user, e.g. https://graph.microsoft.com/v1.0/users/{id}",
          "example": "https://graph.microsoft.com/v1.0/users/625c3e99-c685-447d-8b92-51f5c73c3ad5"
        }
      }
