    "ItemBody": {
      "type": "object",
      "required": ["contentType", "content"],
      "properties": {
        "contentType": {
          "type": "string",
          "enum": ["text", "html"],
          "example": "html"
        },
        "content": {
          "type": "string",
          "example": "<p>Hello Team!</p>"
        }
      }
    },
    "ChatMessageResponse": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
